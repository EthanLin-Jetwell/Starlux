<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_with_Delay__c</fullName>
    <formula>IF
(
Actual_Completion_Time_Local__c &gt; Actual_Planned_Completion_Time_Local__c &amp;&amp;
NOT(ISBLANK(Actual_Completion_Time_Local__c)), TRUE, FALSE
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Completed with Delay</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
