<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Coupon_Cannot_Change_Coupon_Number</fullName>
    <active>true</active>
    <description>Coupon Number cannot be changed once generated</description>
    <errorConditionFormula>NOT(ISNEW()) &amp;&amp;
ISCHANGED( Name )</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Coupon Number cannot be changed.</errorMessage>
</ValidationRule>
