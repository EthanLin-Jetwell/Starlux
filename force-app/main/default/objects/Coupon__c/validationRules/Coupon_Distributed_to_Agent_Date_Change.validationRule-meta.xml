<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Coupon_Distributed_to_Agent_Date_Change</fullName>
    <active>true</active>
    <description>Coupon Distributed to Agent Date cannot be modified after data entry</description>
    <errorConditionFormula>NOT(ISBLANK(PRIORVALUE( Coupon_Distributed_to_Agent_Date__c ))) &amp;&amp; ISCHANGED( Coupon_Distributed_to_Agent_Date__c )</errorConditionFormula>
    <errorDisplayField>Coupon_Distributed_to_Agent_Date__c</errorDisplayField>
    <errorMessage>Coupon Distributed to Agent Date cannot be modified once it is entered.</errorMessage>
</ValidationRule>
