<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Coupon_Employee_ID_7_Digit</fullName>
    <active>true</active>
    <description>Employee ID format must only be 7 digit</description>
    <errorConditionFormula>NOT(ISBLANK( Distributed_Agent__c )) &amp;&amp;
NOT(REGEX( Distributed_Agent__c , &quot;[0-9]{7}&quot;))</errorConditionFormula>
    <errorMessage>Employee ID format must only be 7 digit</errorMessage>
</ValidationRule>
