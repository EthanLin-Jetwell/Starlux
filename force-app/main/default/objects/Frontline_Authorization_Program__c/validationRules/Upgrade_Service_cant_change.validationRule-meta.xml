<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Upgrade_Service_cant_change</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    AND(NOT(ISBLANK(PRIORVALUE(Class_Upgrade__c))), ISCHANGED(Class_Upgrade__c)),
    AND(NOT(ISBLANK(PRIORVALUE(Sector_Upgrade__c))), ISCHANGED(Sector_Upgrade__c)),
    AND(NOT(ISBLANK(PRIORVALUE(Number_of_pax_Upgrade__c))), ISCHANGED(Number_of_pax_Upgrade__c)),
    AND(NOT(ISBLANK(PRIORVALUE(Pax_Name_Upgrade__c))), ISCHANGED(Pax_Name_Upgrade__c)),
    AND(NOT(ISBLANK(PRIORVALUE(Redeem_Request_from_SF_Upgrade__c))), ISCHANGED(Redeem_Request_from_SF_Upgrade__c)),
    AND(NOT(ISBLANK(PRIORVALUE(Redeem_TKT_No_VIP_Lounge_Uprgrade__c))), ISCHANGED(Redeem_TKT_No_VIP_Lounge_Uprgrade__c))
  )</errorConditionFormula>
    <errorMessage>Upgrade Service Detail cannot be modified once it is entered.</errorMessage>
</ValidationRule>
