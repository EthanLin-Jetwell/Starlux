<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Condition_required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Approval_Status__c, &quot;Conditionally Approved&quot;),
    ISBLANK(TEXT(Condition__c))
)</errorConditionFormula>
    <errorDisplayField>Condition__c</errorDisplayField>
    <errorMessage>Condition is required when Approval Status is set to &apos;Conditionally Approved&apos;.</errorMessage>
</ValidationRule>
