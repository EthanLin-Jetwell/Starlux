<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RMS_Noted_Required_PSP</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Replied&quot;),
  Case__r.Case_Record_Type__c = &quot;Group Booking&quot;,
  ISBLANK(RMS_Note_For_PSP__c)
)</errorConditionFormula>
    <errorDisplayField>RMS_Note_For_PSP__c</errorDisplayField>
    <errorMessage>RMS Note is required when Status is set to Replied.</errorMessage>
</ValidationRule>
