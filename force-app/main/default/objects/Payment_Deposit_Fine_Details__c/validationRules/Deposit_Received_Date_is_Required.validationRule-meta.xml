<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deposit_Received_Date_is_Required</fullName>
    <active>true</active>
    <description>Deposit Received Date is required if deposit is received</description>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Deposit&quot; &amp;&amp;  NOT(ISBLANK(Deposit_Amount_Received__c)) &amp;&amp; ISBLANK(Deposit_Received_Date__c)</errorConditionFormula>
    <errorDisplayField>Deposit_Received_Date__c</errorDisplayField>
    <errorMessage>Please enter the deposit received date</errorMessage>
</ValidationRule>
