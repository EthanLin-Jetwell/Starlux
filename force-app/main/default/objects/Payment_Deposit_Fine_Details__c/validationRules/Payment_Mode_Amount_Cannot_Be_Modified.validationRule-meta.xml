<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Payment_Mode_Amount_Cannot_Be_Modified</fullName>
    <active>true</active>
    <errorConditionFormula>RecordType.DeveloperName = &quot;Payment&quot; &amp;&amp;
(
NOT(ISBLANK(TEXT(Payment_Mode__c))) &amp;&amp;
ISCHANGED(Payment_Mode__c)

)</errorConditionFormula>
    <errorMessage>Payment Mode cannot be modified after the payment record is saved.</errorMessage>
</ValidationRule>
