<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Group_Booking_Adjustment_Negative</fullName>
    <active>true</active>
    <description>Group_Booking Adjustment should be negative</description>
    <errorConditionFormula>And(Text( Allocation_Type__c ) = &quot;Adjustment&quot;,  Allocated_Seats__c &gt;=0)</errorConditionFormula>
    <errorDisplayField>Allocated_Seats__c</errorDisplayField>
    <errorMessage>Adjustment should be negative</errorMessage>
</ValidationRule>
