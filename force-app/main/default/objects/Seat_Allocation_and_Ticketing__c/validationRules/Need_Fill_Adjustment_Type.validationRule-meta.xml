<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Need_Fill_Adjustment_Type</fullName>
    <active>true</active>
    <description>Need fill adjustment Type of allocation type is adjustment</description>
    <errorConditionFormula>And(Text( Allocation_Type__c )=&quot;Adjustment&quot;, Isblank (Text( Adjust_Type__c )))</errorConditionFormula>
    <errorDisplayField>Adjust_Type__c</errorDisplayField>
    <errorMessage>Need select Adjust Type if allocation type is Adjustment</errorMessage>
</ValidationRule>
