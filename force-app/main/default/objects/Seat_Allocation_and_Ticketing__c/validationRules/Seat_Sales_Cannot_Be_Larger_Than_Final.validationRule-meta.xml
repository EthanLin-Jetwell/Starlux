<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Seat_Sales_Cannot_Be_Larger_Than_Final</fullName>
    <active>false</active>
    <errorConditionFormula>OR(
Total_Seat_Sales__c &gt; Final_Allocated_Seats__c,
Total_Seat_Sales__c &lt; 0)</errorConditionFormula>
    <errorMessage>Total Seat Sales CANNOT be Larger than Final Allocated Seats or Less than 0</errorMessage>
</ValidationRule>
