<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>vrTicket_Certificate_Invalid</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
NOT(ISPICKVAL(Status__c, &apos;Not Exchange&apos;)),
Redeem_Valid_End_Date__c &lt; TODAY()
)</errorConditionFormula>
    <errorMessage>Redeem Valid End Date later than today.</errorMessage>
</ValidationRule>
