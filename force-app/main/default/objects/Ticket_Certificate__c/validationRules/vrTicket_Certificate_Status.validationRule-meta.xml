<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>vrTicket_Certificate_Status</fullName>
    <active>false</active>
    <description>Ticket has been exchanged.</description>
    <errorConditionFormula>AND(
    ISCHANGED(Status__c),
    ISPICKVAL(PRIORVALUE(Status__c), &apos;Completed&apos;),
    NOT(ISPICKVAL(Status__c, &apos;Completed&apos;))
)</errorConditionFormula>
    <errorMessage>Ticket has been exchanged.</errorMessage>
</ValidationRule>
