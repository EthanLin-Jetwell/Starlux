<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Can_Not_Edit_Route</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(External_Tickets__r.Application_Type__c , &quot;Anonymous&quot;), 
NOT(CONTAINS($Profile.Name, &quot;System&quot;)),
NOT(CONTAINS($Profile.Name, &quot;API&quot;)),
NOT(ISNEW())
)</errorConditionFormula>
    <errorMessage>Can&apos;t edit route.</errorMessage>
</ValidationRule>
