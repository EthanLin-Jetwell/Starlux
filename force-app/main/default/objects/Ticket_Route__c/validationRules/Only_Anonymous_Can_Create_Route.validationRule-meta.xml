<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Only_Anonymous_Can_Create_Route</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(External_Tickets__r.Application_Type__c , &quot;Registered&quot;), 
NOT(CONTAINS($Profile.Name, &quot;System&quot;)),
NOT(CONTAINS($Profile.Name, &quot;API&quot;))
)</errorConditionFormula>
    <errorMessage>&quot;Application Type = Registered&quot; can&apos;t create route.</errorMessage>
</ValidationRule>
